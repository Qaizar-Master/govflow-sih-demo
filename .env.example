# ==========================================================
# GovFlow - environment configuration (SAMPLE)
# Copy to .env and adjust. Never commit a real .env file.
# ==========================================================

NODE_ENV=development

# ---------- Core datastores ----------
# Host-based dev default (docker compose exposes postgres on 5432, redis on 6379)
DATABASE_URL=postgresql://govflow:govflow@localhost:5432/govflow?schema=public
REDIS_URL=redis://localhost:6379

# ---------- Security ----------
# CHANGE THIS. Any non-empty value works for local demos.
JWT_SECRET=dev-only-change-me-govflow-jwt-secret
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# ---------- GovFlow API ----------
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------- Frontend (Next.js) ----------
# Consumed by the browser, so it must be reachable from the host.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- Simulated department systems ----------
IDENTITY_API_URL=http://localhost:5001
MOCK_DEPARTMENTS_PORT=5001
INCOME_API_URL=http://localhost:5001
EDUCATION_API_URL=http://localhost:5001
IDENTITY_API_KEY=identity-demo-key
INCOME_API_TOKEN=income-demo-bearer-token
EDUCATION_BASIC_USER=education
EDUCATION_BASIC_PASS=education-demo-pass

# ---------- Simulated identity provider (MeriPehchaan) ----------
# Two URLs on purpose: the browser is redirected to AUTHORIZE_URL and must be
# able to reach it, while the API exchanges the code over INTERNAL_URL. They
# differ under Docker Compose (localhost:5001 vs mock-departments:5001).
SSO_AUTHORIZE_URL=http://localhost:5001/sso
SSO_INTERNAL_URL=http://localhost:5001/sso
SSO_CLIENT_ID=govflow-demo
SSO_CLIENT_SECRET=sso-demo-client-secret

# ---------- Legacy (CSV) department ----------
LEGACY_CSV_PATH=./data/legacy/beneficiaries.csv

# ---------- Connector / workflow tuning ----------
CONNECTOR_TIMEOUT_MS=4000
WORKFLOW_MAX_ATTEMPTS=3
WORKFLOW_BACKOFF_MS=1500
SLA_TARGET_DAYS=5

# ---------- Documents ----------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=5242880

# ---------- AI (optional) ----------
# Leave GEMINI_API_KEY empty to run fully offline with deterministic
# rule-based validation. The platform stays fully functional either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
