{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@govflow/shared-types": ["packages/shared-types/src/index.ts"],
      "@govflow/shared-types/*": ["packages/shared-types/src/*"],
      "@govflow/config": ["packages/config/src/index.ts"],
      "@govflow/config/*": ["packages/config/src/*"],
      "@govflow/connector-sdk": ["packages/connector-sdk/src/index.ts"],
      "@govflow/connector-sdk/*": ["packages/connector-sdk/src/*"],
      "@govflow/core": ["packages/core/src/index.ts"],
      "@govflow/core/*": ["packages/core/src/*"]
    }
  }
}
