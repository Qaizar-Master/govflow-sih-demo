# Shared image for every GovFlow Node service (API, workflow worker, mock
# departments). Backend code runs straight from TypeScript via tsx, so there is
# no build chain to get out of sync during a demo.
FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma
COPY packages ./packages
COPY apps/api ./apps/api
COPY services ./services
COPY workers ./workers
COPY apps/web/package.json ./apps/web/package.json

RUN npm ci --omit=optional --no-audit --no-fund \
  && npx prisma generate

COPY docker/entrypoint-api.sh /usr/local/bin/entrypoint-api.sh
RUN chmod +x /usr/local/bin/entrypoint-api.sh

COPY data ./data
COPY tsconfig.base.json tsconfig.json ./

ENV NODE_ENV=production
EXPOSE 4000 5001

CMD ["node", "--import", "tsx", "apps/api/src/server.ts"]
