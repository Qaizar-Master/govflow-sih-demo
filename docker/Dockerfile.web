# GovFlow citizen / officer / admin frontend (Next.js).
FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma.config.ts ./
COPY prisma ./prisma
COPY packages ./packages
COPY apps/web ./apps/web
COPY apps/api/package.json ./apps/api/package.json
COPY services/mock-departments/package.json ./services/mock-departments/package.json
COPY workers/workflow-worker/package.json ./workers/workflow-worker/package.json
COPY tsconfig.base.json ./

RUN npm ci --no-audit --no-fund

# NEXT_PUBLIC_* is inlined at build time and is read by the browser, so it must
# point at the host-published API port rather than the compose network name.
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build -w @govflow/web

ENV NODE_ENV=production
EXPOSE 3000

CMD ["npm", "run", "start", "-w", "@govflow/web"]
